{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "default",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "app/(frontend)/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@/components",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks",
    "utils": "@/lib/utils"
  },
  "registries": {
    "@shadercn": "https://shadercn.run/r/{name}.json",
    "@termcn": "https://termcn.vercel.app/r/{name}.json",
    "@mcpcn": "https://mcpcn.dev/r/{name}.json",
    "@ui-layouts": "https://ui-layouts.com/r/{name}.json",
    "@magicui": "https://magicui.design/r/{name}.json",
    "@ogimagecn": "https://ogimagecn.vercel.app/r/{name}.json",
    "@shadcnblocks": "https://www.shadcnblocks.com/r/{style}/{name}"
  }
}